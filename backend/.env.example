# Local port for `uvicorn` to bind to. Render sets its own $PORT in
# production (see render.yaml) — this only matters for local runs.
PORT=8000

# Reserved for Step 2 (Celery + the processing pipeline), which will need
# to read/write `recordings` rows and Storage objects via the service-role
# key, bypassing RLS. Unused by this skeleton — fill in once that step
# lands, using the same Supabase project the Expo app already points at.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
