# Local port for `uvicorn` to bind to. Render sets its own $PORT in
# production (see render.yaml) — this only matters for local runs.
PORT=8000

# Same Supabase project the Expo app already points at (its URL is
# EXPO_PUBLIC_SUPABASE_URL in the frontend's own .env — same value here,
# just without the EXPO_PUBLIC_ prefix). Find both values in the Supabase
# dashboard: Project Settings -> API.
#   SUPABASE_URL                 -> "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY    -> "Project API keys" -> "service_role" (NOT "anon public")
#
# *** SUPABASE_SERVICE_ROLE_KEY IS SECRET. *** It bypasses Row Level
# Security entirely — it must only ever live in this backend's .env (or
# Render's dashboard env vars for the deployed service, see render.yaml,
# which is already set to sync:false there). Never put it in the Expo app,
# EXPO_PUBLIC_* env vars, or any other client-side code — anything prefixed
# EXPO_PUBLIC_ ships inside the app bundle where any user can read it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key (Phase 2 Step 3 — see app/gemini_client.py and
# docs/CLAUDE.md's "AI processing endpoint" section). Get a free key from
# Google AI Studio: https://aistudio.google.com/apikey -> "Create API key"
# (no credit card required for the free tier). Paste it below in your local
# backend/.env — like SUPABASE_SERVICE_ROLE_KEY, this is secret: it must
# never end up in the Expo app or any client-side code, only this backend's
# .env (or Render's dashboard env vars for the deployed service).
GEMINI_API_KEY=

# Optional override for the Gemini model id (see app/config.py — defaults
# to "gemini-3.6-flash" if unset). Google has retired/renamed model ids
# before (gemini-2.5-flash returned a 404 telling callers to switch to
# gemini-3.6-flash during Step 3 testing) — uncomment and set this to swap
# models without a code change/redeploy.
# GEMINI_MODEL=gemini-3.6-flash
