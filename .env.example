# Copy this file to .env and fill in real values from your Supabase project
# settings (Project Settings → API). Never commit .env — it's gitignored.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the FastAPI backend (backend/, see docs/CLAUDE.md's "Backend"
# section). Two cases:
#
# - Local dev via Expo Go on a physical phone: use your laptop's LAN IP, NOT
#   http://localhost:8000 — the phone is a separate device on the same
#   Wi-Fi and can't resolve "localhost" as your laptop. Find your LAN IP
#   with `ipconfig` (Windows, look for "IPv4 Address" under your active
#   Wi-Fi adapter) or `ifconfig`/`ipconfig getifaddr en0` (Mac), then run
#   the backend with `uvicorn app.main:app --reload --host 0.0.0.0` so it
#   actually listens on that interface, not just 127.0.0.1. This IP can
#   change when your laptop reconnects to Wi-Fi/DHCP — re-check it if
#   requests start failing.
#     EXPO_PUBLIC_API_URL=http://192.168.1.23:8000
#
# - Pointing at the deployed backend instead: use the Render URL from
#   docs/CLAUDE.md's "Backend" section.
#     EXPO_PUBLIC_API_URL=https://brevado-api.onrender.com
#
# Switching between them is just editing this value and restarting the Expo
# dev server (`EXPO_PUBLIC_*` vars are read at bundle time, not live).
EXPO_PUBLIC_API_URL=
